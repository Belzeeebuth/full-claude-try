# ============================================================================
#  Harvester — configuration d'environnement
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#  AUCUN secret ne doit être commité. `.env` est ignoré par git.
# ============================================================================

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID de l'application (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=
# Serveur de développement : les commandes y sont déployées instantanément.
# Laissez vide en production pour un déploiement global (propagation ~1 h).
DISCORD_DEV_GUILD_ID=
# Salon (privé) où sont envoyés les rapports d'erreur et les alertes anti-triche
DISCORD_ERROR_CHANNEL_ID=
# Salon où sont publiées les annonces globales (`/admin annonce`)
DISCORD_ANNOUNCE_CHANNEL_ID=
# IDs Discord des administrateurs du bot, séparés par des virgules
BOT_OWNER_IDS=

# ---------------------------------------------------------------------------
# Docker Compose — identifiants des conteneurs db et redis
#   Lus par docker-compose.yml, PAS par l'application.
#   En production, changez IMPÉRATIVEMENT le mot de passe : le conteneur est
#   créé avec au premier démarrage, et le modifier ensuite demande un ALTER
#   ROLE manuel (le volume persiste).
# ---------------------------------------------------------------------------
POSTGRES_USER=harvester
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=harvester
# Ports publiés sur 127.0.0.1 uniquement (voir docker-compose.yml)
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Base de données PostgreSQL 16
#   En Docker Compose, le service `bot` reconstruit DATABASE_URL depuis les
#   variables POSTGRES_* ci-dessus : cette ligne ne sert qu'en exécution locale.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://harvester:harvester@localhost:5432/harvester
# Taille du pool par shard/process (garder pool_max * shards < max_connections PG)
DATABASE_POOL_MAX=12
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Redis 7 (cache, cooldowns, verrous, files BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=harvester
# Active les files BullMQ. Si false, le scheduler bascule sur un timer interne.
QUEUES_ENABLED=true
# Un seul process doit porter les workers/jobs planifiés (le shard 0 par défaut).
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
LOG_PRETTY=true
# Port du serveur de healthcheck / métriques (GET /health, GET /metrics)
HTTP_PORT=3001
# Mode maintenance au démarrage (peut être basculé à chaud via /admin maintenance)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Harvester est en maintenance, revenez dans quelques minutes.

# ---------------------------------------------------------------------------
# Sharding (requis au-delà de ~2500 serveurs)
# ---------------------------------------------------------------------------
# auto | nombre entier
SHARD_COUNT=auto
SHARD_LIST=auto

# ---------------------------------------------------------------------------
# Gameplay (surcharge les valeurs de src/config/gameplay/balance.json)
# ---------------------------------------------------------------------------
# Durée d'une saison en jours réels
SEASON_LENGTH_DAYS=14
# Multiplicateur global de vitesse de pousse (2 = deux fois plus rapide)
GLOBAL_GROWTH_MULTIPLIER=1
# Multiplicateur global de gains (événements, week-ends doublés…)
GLOBAL_ECONOMY_MULTIPLIER=1
# Système d'énergie : true = chaque action consomme de l'énergie
ENERGY_SYSTEM_ENABLED=true
# Intervalle de mise à jour du marché (minutes)
MARKET_UPDATE_MINUTES=60

# ---------------------------------------------------------------------------
# Rendu d'images
# ---------------------------------------------------------------------------
RENDER_ENABLED=true
# Cache Redis des PNG générés (secondes)
RENDER_CACHE_TTL=120
# Répertoire des sprites (voir docs/05-pipeline-assets.md)
ASSETS_DIR=./assets
# Au-delà de ce budget de rendu, on renvoie un embed texte (ms)
RENDER_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Intégrations optionnelles
# ---------------------------------------------------------------------------
TOPGG_TOKEN=
TOPGG_WEBHOOK_SECRET=
TOPGG_VOTE_URL=https://top.gg/bot/000000000000000000/vote
