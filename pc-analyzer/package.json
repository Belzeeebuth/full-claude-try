{
  "name": "pc-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analyse, diagnostic virtuel et comparaison de PC (fixes et portables) — Windows & Linux au même niveau",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:check": "node packages/db/scripts/check-schema.mjs",
    "build:demo": "npm run build -w @pc-analyzer/demo"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
